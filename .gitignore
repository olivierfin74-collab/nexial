# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Backups & dumps locaux
*.zip
*.tar.gz
nexial-audit*
*-backup*

# Sandbox abandonnée
/nexial-app/

# Claude Code local settings (user-specific permissions cache)
.claude/

# Supabase CLI cache (linked project metadata, version cache)
supabase/.temp
supabase/.branches

# Backups locaux (jsx, ts, etc.) — jamais commités
*.bak
*.bak-*
*.backup
